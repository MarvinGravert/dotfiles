[user]
	name = Marvin Gravert
	email = marvin.g@noota.io

[core]
	editor = code --wait

[init]
	defaultBranch = main

# ---------------------------------------------------------------------------
# Diff & merge (VS Code)
# https://medium.com/faun/using-vscode-as-git-mergetool-and-difftool-2e241123abe7
# ---------------------------------------------------------------------------
[diff]
	tool = vscode
	# a different algorithm plus color => more readable
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true
[difftool "vscode"]
	cmd = code --wait --diff \"$LOCAL\" \"$REMOTE\"
[merge]
	tool = vscode
[mergetool "vscode"]
	cmd = code --wait \"$MERGED\"

# ---------------------------------------------------------------------------
# Sensible defaults
# https://blog.gitbutler.com/how-git-core-devs-configure-git/
# ---------------------------------------------------------------------------
# Sorting based on last commit and putting branches in columns
[column]
	ui = auto
[branch]
	sort = -committerdate
# Sorting tags correctly => 0.5.101 before 0.5.1000
[tag]
	sort = version:refname
# Auto-push tags and set up the remote branch if it doesn't exist
[push]
	autoSetupRemote = true
	followTags = true
# Remove origin/X branches locally that were deleted on origin
[fetch]
	prune = true
	pruneTags = true
	all = true
# Show the diff in the commit message editor
[commit]
	verbose = true
[advice]
	pushNonFastForward = false

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[pretty]
	pretty-history = format:%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset

# ---------------------------------------------------------------------------
# Aliases
# ---------------------------------------------------------------------------
[alias]
	cl = clone
	co = commit
	ch = checkout

	# Branches
	b = branch
	ba = branch -a          # all branches, remote and local
	bd = branch -d          # delete (must be fully merged)
	bdd = branch -D         # force delete
	recent = branch --sort=-committerdate

	# Delete local branches already merged (keeps current, main, master, dev, develop)
	cleanup = "!git branch --merged | grep -vE '^\\*|^[[:space:]]*(main|master|dev|develop)$' | xargs -r -n 1 git branch -d"

	# Undo / reset
	undo = reset --soft HEAD^   # undo last commit, keep changes staged
	unstage = reset HEAD
	re = reset
	rh = reset HEAD^
	reh = reset --hard
	rem = reset --mixed
	res = reset --soft
	rehh = reset --hard HEAD
	remh = reset --mixed HEAD
	resh = reset --soft HEAD
	rehom = reset --hard origin/master
	rehu = reset --hard @{upstream}   # reset to whatever the branch tracks (main or master)

	# Logs
	lg = lg1
	lg1 = lg1-specific --all
	lg2 = lg2-specific --all
	lg3 = lg3-specific --all
	lg1-specific = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(auto)%d%C(reset)'
	lg2-specific = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(reset) %C(bold green)(%ar)%C(reset)%C(auto)%d%C(reset)%n''          %C(white)%s%C(reset) %C(dim white)- %an%C(reset)'
	lg3-specific = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(reset) %C(bold green)(%ar)%C(reset) %C(bold cyan)(committed: %cD)%C(reset) %C(auto)%d%C(reset)%n''          %C(white)%s%C(reset)%n''          %C(dim white)- %an <%ae> %C(reset) %C(dim white)(committer: %cn <%ce>)%C(reset)'

	count-lines = "! git log --author=\"$1\" --pretty=tformat: --numstat | awk '{ add += $1; subs += $2; loc += $1 - $2 } END { printf \"added lines: %s, removed lines: %s, total lines: %s\\n\", add, subs, loc }' #"
